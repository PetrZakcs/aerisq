      body: JSON.stringify({ title: s.newBlogTitle, excerpt: s.newBlogExcerpt, content: s.newBlogContent })
    });
    this.setState({ newBlogTitle: '', newBlogExcerpt: '', newBlogContent: '' });
    this.loadAll(s.session);
