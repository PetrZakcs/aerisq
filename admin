      const data = await res.json();
      if (res.ok && data.access_token) {
        const session = { access_token: data.access_token, email: data.user?.email || email };
        localStorage.setItem('aerisq_admin_session', JSON.stringify(session));
        this.setState({ session, loginError: '' });
        this.loadAll(session);
      } else {
        this.setState({ loginError: data.error_description || data.msg || 'Nesprávné přihlašovací jméno nebo heslo.' });
