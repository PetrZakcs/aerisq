<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet data-dc-atomics>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin — AerisQ</title>
<meta name="robots" content="noindex">
<link rel="icon" type="image/png" href="./favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>html{scroll-behavior:smooth}body{margin:0;background:#000}
@keyframes pulseDot{0%,100%{opacity:1}50%{opacity:.6}}</style>
</helmet>

<div style="background:#000;color:#fafafa;min-height:100vh;font-family:'Manrope',system-ui,sans-serif;-webkit-font-smoothing:antialiased">

<sc-if value="{{ isLoggedOut }}" hint-placeholder-val="{{ true }}">
  <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">
    <div style="max-width:380px;width:100%;border:1px solid rgba(255,255,255,.1);border-radius:8px;background:#0a0a0a;padding:36px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:28px">
        <span style="display:flex;align-items:center;gap:4px">
          <span style="width:6px;height:6px;border-radius:50%;background:#52525b"></span>
          <span style="width:14px;height:1px;background:#52525b"></span>
          <span style="width:9px;height:9px;border-radius:50%;background:#34d399"></span>
          <span style="width:14px;height:1px;background:#52525b"></span>
          <span style="width:6px;height:6px;border-radius:50%;background:#52525b"></span>
        </span>
        <span style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:17px;letter-spacing:-.02em">Aeris<span style="color:#34d399">Q</span> <span style="color:#71717a;font-weight:500">/ admin</span></span>
      </div>

      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;color:#71717a;letter-spacing:.04em;margin-bottom:16px">// PŘIHLÁŠENÍ SOUKROMÉ SPRÁVY</div>
      <input placeholder="Přihlašovací jméno / e-mail" value="{{ loginEmail }}" onChange="{{ setLoginEmail }}" style="width:100%;padding:13px 14px;background:#000;border:1px solid rgba(255,255,255,.14);border-radius:4px;color:#fafafa;font-size:14px;font-family:'Manrope',sans-serif;margin-bottom:14px;box-sizing:border-box" style-focus="border-color:#34d399;outline:none" />
      <input type="password" placeholder="Heslo" value="{{ loginPassword }}" onChange="{{ setLoginPassword }}" style="width:100%;padding:13px 14px;background:#000;border:1px solid rgba(255,255,255,.14);border-radius:4px;color:#fafafa;font-size:14px;font-family:'Manrope',sans-serif;margin-bottom:18px;box-sizing:border-box" style-focus="border-color:#34d399;outline:none" />
      <button onClick="{{ loginWithPassword }}" disabled="{{ loginCannotSubmit }}" style="{{ loginBtnStyle }}">Vstoupit do administrace</button>
      <sc-if value="{{ loginError }}" hint-placeholder-val="{{ false }}">
        <p style="color:#f87171;font-size:12px;font-family:'JetBrains Mono',monospace;margin:12px 0 0">{{ loginError }}</p>
      </sc-if>
    </div>
  </div>
</sc-if>

<sc-if value="{{ isLoggedIn }}" hint-placeholder-val="{{ false }}">
  <nav style="position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px clamp(20px,4vw,40px);background:rgba(0,0,0,.9);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,255,255,.08);flex-wrap:wrap">
    <div style="display:flex;align-items:center;gap:8px">
      <span style="display:flex;align-items:center;gap:4px">
        <span style="width:6px;height:6px;border-radius:50%;background:#52525b"></span>
        <span style="width:14px;height:1px;background:#52525b"></span>
        <span style="width:9px;height:9px;border-radius:50%;background:#34d399"></span>
        <span style="width:14px;height:1px;background:#52525b"></span>
        <span style="width:6px;height:6px;border-radius:50%;background:#52525b"></span>
      </span>
      <span style="font-family:'JetBrains Mono',monospace;font-weight:700;font-size:17px;letter-spacing:-.02em">Aeris<span style="color:#34d399">Q</span> <span style="color:#71717a;font-weight:500">/ admin</span></span>
    </div>
    <div style="display:flex;align-items:center;gap:16px">
      <span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a">{{ sessionEmail }}</span>
      <button onClick="{{ logout }}" style="background:transparent;border:1px solid rgba(255,255,255,.14);color:#a1a1aa;border-radius:4px;padding:7px 14px;font-family:'JetBrains Mono',monospace;font-size:11px;cursor:pointer">Sign out</button>
    </div>
  </nav>

  <div style="display:flex;border-bottom:1px solid rgba(255,255,255,.08);padding:0 clamp(20px,4vw,40px);overflow-x:auto">
    <sc-for list="{{ tabs }}" as="tab" hint-placeholder-count="4">
      <button onClick="{{ tab.onClick }}" style="{{ tab.style }}">{{ tab.label }}</button>
    </sc-for>
  </div>

  <div style="max-width:1200px;margin:0 auto;padding:32px clamp(20px,4vw,40px) 80px">

    <sc-if value="{{ isLeadsTab }}" hint-placeholder-val="{{ true }}">
      <div style="display:flex;flex-direction:column;gap:32px">
        <div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;letter-spacing:.04em;margin-bottom:12px">AUDIT REQUESTS ({{ auditRequests.length }})</div>
          <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;overflow:hidden">
            <sc-for list="{{ auditRequests }}" as="lead" hint-placeholder-count="3">
              <div style="padding:16px 18px;border-bottom:1px solid rgba(255,255,255,.06);background:#0a0a0a;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;font-size:13px">
                <div><strong style="color:#fafafa">{{ lead.name }}</strong><div style="color:#71717a;font-family:'JetBrains Mono',monospace;font-size:11px">{{ lead.email }}</div></div>
                <div style="color:#a1a1aa">{{ lead.company }}</div>
                <div style="color:#a1a1aa">{{ lead.focus }} · {{ lead.budget }}</div>
                <div style="color:#71717a;font-family:'JetBrains Mono',monospace;font-size:11px">{{ lead.created_at }}</div>
              </div>
            </sc-for>
          </div>
        </div>
        <div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;letter-spacing:.04em;margin-bottom:12px">NEWSLETTER SUBSCRIBERS ({{ newsletterSubs.length }})</div>
          <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;overflow:hidden">
            <sc-for list="{{ newsletterSubs }}" as="sub" hint-placeholder-count="3">
              <div style="padding:14px 18px;border-bottom:1px solid rgba(255,255,255,.06);background:#0a0a0a;display:flex;justify-content:space-between;font-size:13px">
                <span>{{ sub.email }}</span>
                <span style="color:#71717a;font-family:'JetBrains Mono',monospace;font-size:11px">{{ sub.created_at }}</span>
              </div>
            </sc-for>
          </div>
        </div>
        <div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;letter-spacing:.04em;margin-bottom:12px">APPLICATIONS ({{ applications.length }})</div>
          <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;overflow:hidden">
            <sc-for list="{{ applications }}" as="app" hint-placeholder-count="3">
              <div style="padding:16px 18px;border-bottom:1px solid rgba(255,255,255,.06);background:#0a0a0a;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;font-size:13px">
                <div><strong style="color:#fafafa">{{ app.name }}</strong><div style="color:#71717a;font-family:'JetBrains Mono',monospace;font-size:11px">{{ app.email }}</div></div>
                <div style="color:#a1a1aa">{{ app.role_interest }}</div>
                <div style="color:#a1a1aa">{{ app.comp_expectation }}</div>
                <a href="{{ app.cv_link }}" target="_blank" style="color:#34d399;font-family:'JetBrains Mono',monospace;font-size:11px;text-decoration:none">CV →</a>
              </div>
            </sc-for>
          </div>
        </div>
      </div>
    </sc-if>

    <sc-if value="{{ isClientsTab }}" hint-placeholder-val="{{ false }}">
      <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;background:#0a0a0a;padding:24px;margin-bottom:24px">
        <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;letter-spacing:.04em;margin-bottom:14px">NEW CLIENT</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:14px">
          <input placeholder="Name" value="{{ newClientName }}" onChange="{{ setNewClientName }}" style="{{ inputStyle }}" />
          <input placeholder="Company" value="{{ newClientCompany }}" onChange="{{ setNewClientCompany }}" style="{{ inputStyle }}" />
          <input placeholder="Email" value="{{ newClientEmail }}" onChange="{{ setNewClientEmail }}" style="{{ inputStyle }}" />
        </div>
        <button onClick="{{ createClient }}" disabled="{{ newClientCannotSubmit }}" style="{{ primaryBtnStyle }}">Add Client</button>
      </div>
      <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;overflow:hidden">
        <sc-for list="{{ clients }}" as="client" hint-placeholder-count="3">
          <div style="padding:16px 18px;border-bottom:1px solid rgba(255,255,255,.06);background:#0a0a0a;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
            <div>
              <strong style="color:#fafafa;font-size:14px">{{ client.name }}</strong>
              <div style="color:#71717a;font-size:12px;font-family:'JetBrains Mono',monospace">{{ client.company }} · {{ client.email }}</div>
            </div>
            <button onClick="{{ client.onDelete }}" style="background:transparent;border:1px solid rgba(255,255,255,.14);color:#71717a;border-radius:4px;padding:6px 12px;font-family:'JetBrains Mono',monospace;font-size:11px;cursor:pointer">Delete</button>
          </div>
        </sc-for>
      </div>
    </sc-if>

    <sc-if value="{{ isProjectsTab }}" hint-placeholder-val="{{ false }}">
      <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;background:#0a0a0a;padding:24px;margin-bottom:24px">
        <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;letter-spacing:.04em;margin-bottom:14px">NEW PROJECT</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin-bottom:14px">
          <input placeholder="Project name" value="{{ newProjectName }}" onChange="{{ setNewProjectName }}" style="{{ inputStyle }}" />
          <select value="{{ newProjectClientId }}" onChange="{{ setNewProjectClientId }}" style="{{ inputStyle }}">
            <option value="">Select client</option>
            <sc-for list="{{ clients }}" as="c" hint-placeholder-count="3">
              <option value="{{ c.id }}">{{ c.name }}</option>
            </sc-for>
          </select>
          <select value="{{ newProjectPhase }}" onChange="{{ setNewProjectPhase }}" style="{{ inputStyle }}">
            <option value="1">Phase 1 — Discovery</option>
            <option value="2">Phase 2 — Engineering</option>
            <option value="3">Phase 3 — Deployment</option>
          </select>
          <input type="date" value="{{ newProjectTargetDate }}" onChange="{{ setNewProjectTargetDate }}" style="{{ inputStyle }}" />
        </div>
        <button onClick="{{ createProject }}" disabled="{{ newProjectCannotSubmit }}" style="{{ primaryBtnStyle }}">Add Project</button>
      </div>

      <div style="display:flex;flex-direction:column;gap:16px">
        <sc-for list="{{ projects }}" as="project" hint-placeholder-count="3">
          <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;background:#0a0a0a;padding:22px">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:10px;margin-bottom:14px">
              <div>
                <div style="font-size:15px;font-weight:700;color:#fafafa">{{ project.name }}</div>
                <div style="color:#71717a;font-size:12px;font-family:'JetBrains Mono',monospace">{{ project.clientName }} · target {{ project.target_date }}</div>
              </div>
              <div style="display:flex;align-items:center;gap:8px">
                <select value="{{ project.phase }}" onChange="{{ project.onPhaseChange }}" style="{{ smallSelectStyle }}">
                  <option value="1">Phase 1</option>
                  <option value="2">Phase 2</option>
                  <option value="3">Phase 3</option>
                </select>
                <button onClick="{{ project.onDelete }}" style="background:transparent;border:1px solid rgba(255,255,255,.14);color:#71717a;border-radius:4px;padding:6px 12px;font-family:'JetBrains Mono',monospace;font-size:11px;cursor:pointer">Delete</button>
              </div>
            </div>

            <div style="border-top:1px solid rgba(255,255,255,.08);padding-top:14px;margin-bottom:14px">
              <div style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#52525b;letter-spacing:.04em;margin-bottom:8px">MILESTONES</div>
              <sc-for list="{{ project.milestones }}" as="m" hint-placeholder-count="2">
                <div style="display:flex;justify-content:space-between;padding:6px 0;font-size:13px;color:#a1a1aa">
                  <span>{{ m.title }} — {{ m.due_date }}</span>
                  <button onClick="{{ m.onDelete }}" style="background:none;border:none;color:#52525b;cursor:pointer;font-size:11px;font-family:'JetBrains Mono',monospace">✕</button>
                </div>
              </sc-for>
              <div style="display:flex;gap:8px;margin-top:8px">
                <input placeholder="Milestone" value="{{ project.newMilestoneTitle }}" onChange="{{ project.onMilestoneTitleChange }}" style="{{ inputStyle }};flex:1" />
                <input type="date" value="{{ project.newMilestoneDate }}" onChange="{{ project.onMilestoneDateChange }}" style="{{ inputStyle }}" />
                <button onClick="{{ project.onAddMilestone }}" style="background:#34d399;color:#000;border:none;border-radius:4px;padding:0 14px;font-family:'JetBrains Mono',monospace;font-size:11px;cursor:pointer;font-weight:700">+</button>
              </div>
            </div>

            <div style="border-top:1px solid rgba(255,255,255,.08);padding-top:14px">
              <div style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#52525b;letter-spacing:.04em;margin-bottom:8px">INVOICES</div>
              <sc-for list="{{ project.invoices }}" as="inv" hint-placeholder-count="2">
                <div style="display:flex;justify-content:space-between;padding:6px 0;font-size:13px;color:#a1a1aa">
                  <span>{{ inv.amount }} {{ inv.currency }} — {{ inv.status }} (due {{ inv.due_date }})</span>
                  <button onClick="{{ inv.onDelete }}" style="background:none;border:none;color:#52525b;cursor:pointer;font-size:11px;font-family:'JetBrains Mono',monospace">✕</button>
                </div>
              </sc-for>
              <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
                <input placeholder="Amount" value="{{ project.newInvoiceAmount }}" onChange="{{ project.onInvoiceAmountChange }}" style="{{ inputStyle }};width:100px" />
                <select value="{{ project.newInvoiceStatus }}" onChange="{{ project.onInvoiceStatusChange }}" style="{{ inputStyle }}">
                  <option value="draft">Draft</option>
                  <option value="sent">Sent</option>
                  <option value="paid">Paid</option>
                </select>
                <input type="date" value="{{ project.newInvoiceDueDate }}" onChange="{{ project.onInvoiceDueDateChange }}" style="{{ inputStyle }}" />
                <button onClick="{{ project.onAddInvoice }}" style="background:#34d399;color:#000;border:none;border-radius:4px;padding:0 14px;font-family:'JetBrains Mono',monospace;font-size:11px;cursor:pointer;font-weight:700">+</button>
              </div>
            </div>
          </div>
        </sc-for>
      </div>
    </sc-if>

    <sc-if value="{{ isDocumentsTab }}" hint-placeholder-val="{{ false }}">
      <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;background:#0a0a0a;padding:24px;margin-bottom:24px">
        <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;letter-spacing:.04em;margin-bottom:14px">UPLOAD DOCUMENT</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:14px">
          <select value="{{ newDocProjectId }}" onChange="{{ setNewDocProjectId }}" style="{{ inputStyle }}">
            <option value="">Select project</option>
            <sc-for list="{{ projects }}" as="p" hint-placeholder-count="3">
              <option value="{{ p.id }}">{{ p.name }}</option>
            </sc-for>
          </select>
          <input placeholder="Title" value="{{ newDocTitle }}" onChange="{{ setNewDocTitle }}" style="{{ inputStyle }}" />
          <label style="display:flex;align-items:center;justify-content:center;padding:11px;background:#000;border:1px dashed rgba(255,255,255,.2);border-radius:4px;cursor:pointer;color:#a1a1aa;font-size:13px">
            <span>{{ newDocFileLabel }}</span>
            <input type="file" onChange="{{ handleDocFile }}" style="display:none" />
          </label>
        </div>
        <button onClick="{{ uploadDocument }}" disabled="{{ newDocCannotSubmit }}" style="{{ primaryBtnStyle }}">Upload</button>
      </div>
      <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;overflow:hidden">
        <sc-for list="{{ documents }}" as="doc" hint-placeholder-count="3">
          <div style="padding:16px 18px;border-bottom:1px solid rgba(255,255,255,.06);background:#0a0a0a;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
            <div>
              <strong style="color:#fafafa;font-size:14px">{{ doc.title }}</strong>
              <div style="color:#71717a;font-size:12px;font-family:'JetBrains Mono',monospace">{{ doc.projectName }}</div>
            </div>
            <div style="display:flex;gap:10px;align-items:center">
              <a href="{{ doc.file_url }}" target="_blank" style="color:#34d399;font-family:'JetBrains Mono',monospace;font-size:11px;text-decoration:none">Open →</a>
              <button onClick="{{ doc.onDelete }}" style="background:transparent;border:1px solid rgba(255,255,255,.14);color:#71717a;border-radius:4px;padding:6px 12px;font-family:'JetBrains Mono',monospace;font-size:11px;cursor:pointer">Delete</button>
            </div>
          </div>
        </sc-for>
      </div>
    </sc-if>

    <sc-if value="{{ isCmsTab }}" hint-placeholder-val="{{ false }}">
      <div style="display:flex;flex-direction:column;gap:32px">
        <!-- Texty a Nadpisy Webové Stránky -->
        <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;background:#0a0a0a;padding:24px">
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#34d399;letter-spacing:.04em;margin-bottom:14px">// HLAVNÍ TEXTY & HERO SEKCÍ</div>
          <div style="display:flex;flex-direction:column;gap:16px;max-width:760px">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div>
                <label style="display:block;font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;margin-bottom:4px">HERO NADPIS (EN)</label>
                <input value="{{ heroTitleEn }}" onChange="{{ setHeroTitleEn }}" style="{{ inputStyle }};width:100%" />
              </div>
              <div>
                <label style="display:block;font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;margin-bottom:4px">HERO NADPIS (CS)</label>
                <input value="{{ heroTitleCs }}" onChange="{{ setHeroTitleCs }}" style="{{ inputStyle }};width:100%" />
              </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
              <div>
                <label style="display:block;font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;margin-bottom:4px">HERO PODNADPIS (EN)</label>
                <textarea value="{{ heroSubEn }}" onChange="{{ setHeroSubEn }}" rows="3" style="{{ inputStyle }};width:100%;resize:vertical"></textarea>
              </div>
              <div>
                <label style="display:block;font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;margin-bottom:4px">HERO PODNADPIS (CS)</label>
                <textarea value="{{ heroSubCs }}" onChange="{{ setHeroSubCs }}" rows="3" style="{{ inputStyle }};width:100%;resize:vertical"></textarea>
              </div>
            </div>
            <div>
              <label style="display:block;font-family:'JetBrains Mono',monospace;font-size:11px;color:#71717a;margin-bottom:4px">BANER AUDITU DOSTUPNOSTI (SCARCITY)</label>
              <input value="{{ auditScarcity }}" onChange="{{ setAuditScarcity }}" style="{{ inputStyle }};width:100%" />
            </div>
            <div style="display:flex;align-items:center;gap:14px;margin-top:6px">
              <button onClick="{{ saveCmsChanges }}" style="{{ primaryBtnStyle }}">Uložit základní texty</button>
              <sc-if value="{{ cmsSaved }}" hint-placeholder-val="{{ false }}">
                <span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:#34d399">✓ Uloženo</span>
              </sc-if>
            </div>
          </div>
        </div>

        <!-- Správa Blogu -->
        <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;background:#0a0a0a;padding:24px">
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#34d399;letter-spacing:.04em;margin-bottom:14px">// SPRÁVA BLOGU (ČLÁNKY)</div>
          <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;max-width:760px">
            <input placeholder="Název článku" value="{{ newBlogTitle }}" onChange="{{ setNewBlogTitle }}" style="{{ inputStyle }}" />
            <textarea placeholder="Perex / Krátký popis článku" value="{{ newBlogExcerpt }}" onChange="{{ setNewBlogExcerpt }}" rows="2" style="{{ inputStyle }};resize:vertical"></textarea>
            <textarea placeholder="Obsah článku (Markdown / Text)" value="{{ newBlogContent }}" onChange="{{ setNewBlogContent }}" rows="5" style="{{ inputStyle }};resize:vertical"></textarea>
            <button onClick="{{ createBlogPost }}" disabled="{{ newBlogCannotSubmit }}" style="{{ primaryBtnStyle }}">Publikovat nový článek</button>
          </div>
          <div style="border:1px solid rgba(255,255,255,.08);border-radius:6px;overflow:hidden">
            <sc-for list="{{ blogPosts }}" as="post" hint-placeholder-count="2">
              <div style="padding:14px 18px;border-bottom:1px solid rgba(255,255,255,.06);background:#050505;display:flex;justify-content:space-between;align-items:center;gap:12px">
                <div>
                  <strong style="color:#fafafa;font-size:14px">{{ post.title }}</strong>
                  <div style="color:#71717a;font-size:12px">{{ post.excerpt }}</div>
                </div>
                <button onClick="{{ post.onDelete }}" style="background:transparent;border:1px solid rgba(255,255,255,.14);color:#71717a;border-radius:4px;padding:6px 12px;font-family:'JetBrains Mono',monospace;font-size:11px;cursor:pointer">Smazat</button>
              </div>
            </sc-for>
          </div>
        </div>

        <!-- Správa Case Studies -->
        <div style="border:1px solid rgba(255,255,255,.1);border-radius:6px;background:#0a0a0a;padding:24px">
          <div style="font-family:'JetBrains Mono',monospace;font-size:11px;color:#34d399;letter-spacing:.04em;margin-bottom:14px">// SPRÁVA CASE STUDIES (PŘÍPADOVÉ STUDIE)</div>
