{
  "cleanUrls": true,
  "proxy": {
    "entrypoint": "proxy.js"
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/clients",
      "destination": "/portal.html"
    },
    {
      "source": "/clients/(.*)",
      "destination": "/portal.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/portal/(.*)",
      "destination": "/portal.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
